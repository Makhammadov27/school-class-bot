# Telegram Bot Token (BotFather'dan olinadi)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Google Gemini API Key (Google AI Studio - https://aistudio.google.com/ dan bepul olinadi)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Admin (Sinf rahbari/o'qituvchi) Telegram ID raqamlari (vergul bilan ajratilgan)
ADMIN_IDS=123456789,987654321

# Ballar sozlamasi
ATTENDANCE_POINTS=5
QUIZ_POINT_MULTIPLIER=10
# Server va bot vaqti
TZ=Asia/Tashkent
